# Required before exposing admin routes publicly
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
BOOKING_TOKEN_SECRET=use-a-different-long-random-secret
PUBLIC_BASE_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg

# Optional SMTP email confirmations/reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@example.com
RESEND_API_KEY=
RESEND_FROM=Inner Health <bookings@example.com>

# Optional webhook receiving JSON {"to":"+27...","message":"..."}
WHATSAPP_WEBHOOK_URL=

# Ollama running on the Inner Health ZeroTier Mac mini
OLLAMA_BASE_URL=http://10.147.19.146:11434
# Set this to a model installed on the Mac mini (check `ollama list`)
OLLAMA_MODEL=llama3.2

# Cloud database (set to a managed PostgreSQL URL in cloud deployments).
# Leave unset for local SQLite fallback, or set for Docker Compose:
# DATABASE_URL=postgresql+psycopg://innerhealth:replace-me@localhost:5432/innerhealth
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local fallback Ollama (install/run on the same host as FastAPI)
OLLAMA_FALLBACK_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Optional checkout provider URL and authenticated payment webhook
DEPOSIT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=
AI_AGENT_KEY=generate-a-long-random-key-and-use-the-same-value-on-the-m4

# EFT details shown on pending booking pages; payment is confirmed by an admin
BANK_ACCOUNT_NAME=
BANK_NAME=FNB
BANK_ACCOUNT_NUMBER=62804835835
BANK_BRANCH_CODE=
BANK_ACCOUNT_TYPE=

# Social profile links (optional; include full https:// URLs)
FACEBOOK_URL=https://www.facebook.com/share/1Cfx8cayqM/
INSTAGRAM_URL=
TIKTOK_URL=
WHATSAPP_NUMBER=2785771853
